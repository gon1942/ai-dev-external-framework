{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "task": "allow",
    "skill": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset --hard *": "deny",
      "rm -rf *": "ask"
    },
    "external_directory": "allow",
    "doom_loop": "ask"
  },
  "lsp": true
}
